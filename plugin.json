{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sleuth-audit",
  "version": "0.1.0",
  "description": "Audit repositories for latent correctness defects, assess severity and confidence separately, and save resumable YAML checkpoints and Markdown reports.",
  "repository": "https://github.com/Imagination12357/sleuth-audit",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Sleuth Audit",
        "shortDescription": "Find correctness defects",
        "defaultPrompt": [
          "Use $sleuth-audit to audit this repository."
        ]
      }
    }
  }
}
